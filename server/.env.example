# Copy this to .env and fill in the values

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:3001/auth/google/callback (dev)
#                          https://yourdomain.com/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── User → Email mapping ──────────────────────────────────────────────────────
# Map each team member's Faddom Google email to their tracker username.
# Format: email:Username,email:Username  (no spaces around : or ,)
USER_EMAIL_MAP=egor@faddom.com:Egor,yonatan@faddom.com:Yonatan,mariano@faddom.com:Mariano,ben@faddom.com:Ben

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Webhook security ──────────────────────────────────────────────────────────
# Optional. If set, all webhook endpoints require this header:
#   x-webhook-secret: <value>
# Set the same value in your Make.com / Intercom webhook config.
WEBHOOK_SECRET=

# ── Production only ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
